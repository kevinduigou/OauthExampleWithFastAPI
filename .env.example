# Copy this file to .env and fill in your actual credentials

# JWT / session security
SECRET_KEY=your-secret-key-for-jwt-signing

# OAuth Configuration
# Get Google credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/google/callback


# Get Twitter credentials from: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/auth/twitter/callback

# SMTP (Brevo/Mail server) configuration for account validation emails
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@example.com

# Deployment / frontend URLs
DEPLOYMENT_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000/app

# Frontend runtime variable (passed to container at runtime)
# Set VITE_DEPLOYMENT_URL when running the frontend container
# Example: docker run -e VITE_DEPLOYMENT_URL=https://api.example.com ...

# MongoDB configuration for user repository
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=auth_example

# Optional: Redis URL for background jobs
REDIS_URL=redis://localhost:6379/0
